# --- Database (required) ---
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/minar?schema=public"

# --- AI (optional — leave unset to keep using the built-in mock assistant) ---
# When set, lib/services/aiService.ts can be switched to call the real
# OpenAI API instead of its rule-based mock responses. No UI or route
# code needs to change — see the comment block at the top of that file.
OPENAI_API_KEY=""

# --- Maps (optional — leave unset to keep using the built-in mock map) ---
# When set, components/map/MapView.tsx's provider adapter can be switched
# from the mock renderer to Google Maps or Mapbox.
NEXT_PUBLIC_MAPS_PROVIDER="mock" # "mock" | "google" | "mapbox"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""

# --- Session ---
SESSION_COOKIE_NAME="minar_session"
SESSION_TTL_MINUTES="120"
